require "../../../pdfbox"

module Pdfbox::Examples::Interactive::Form
  # Add a border to an existing field.
  # Builds on the form generated by CreateSimpleForm, so run that first.
  # Java: org.apache.pdfbox.examples.interactive.form.AddBorderToField
  class AddBorderToField
    RESULT_FILENAME = "target/AddBorderToField.pdf"

    def self.main(args : Array(String)? = nil) : Nil
      document = Pdfbox::Loader.load_pdf(CreateSimpleForm::DEFAULT_FILENAME)
      begin
        # ameba:disable Lint/NotNil
        acro_form = document.document_catalog.not_nil!.acro_form
        # ameba:disable Lint/NotNil
        field = acro_form.not_nil!.get_field("SampleField").not_nil!
        widget = field.widgets[0]

        field_appearance = Pdfbox::Pdmodel::Interactive::Annotation::PDAppearanceCharacteristicsDictionary.new(Pdfbox::Cos::Dictionary.new)
        red = Pdfbox::Pdmodel::Graphics::Color::PDColor.new([1.0_f32, 0.0_f32, 0.0_f32], Pdfbox::Pdmodel::Graphics::Color::PDDeviceRGB::INSTANCE)
        field_appearance.border_colour = red

        widget.appearance_characteristics = field_appearance

        document.save(RESULT_FILENAME)
      ensure
        document.close
      end
    end
  end
end
