/lib/*
!/lib/bidi/
/lib/bidi/*
!/lib/bidi/src/
!/lib/bidi/src/**
/bin/
/.shards/
*.dwarf

# Libraries don't need dependency lock
# Dependencies will be locked in applications that use them
/shard.lock

# Test/debug scripts
test_*.cr
test_*_release

# Temporary files
/temp/

# Compiled executables
/cmap
/pdfbox
/resources/

# Backup files
*.bak
*.backup

# Temporary directories
cff_parser/

# Git worktrees
.worktrees/

# Crystal compiler cache
.crystal-cache/

# Local agent/tool settings
.claude/

# Dolt database files (added by bd init)
.dolt/
*.db
scripts/

# Beads / Dolt files (added by bd init)
.beads-credential-key

# Apple Double / Extended Attributes (macOS FAT32 artifacts)
._*
.DS_Store

# Fix scripts
fix_*.rb
