/lib/*
!/lib/bidi/
/lib/bidi/*
!/lib/bidi/src/
!/lib/bidi/src/**
/bin/
/.shards/
*.dwarf

# Libraries don't need dependency lock
# Dependencies will be locked in applications that use them
/shard.lock

# Test/debug scripts
test_*.cr
test_*_release

# Compiled binaries built in the repo root
/font

# Temporary files
/temp/
/target/

# Compiled executables
/cmap
/pdfbox
/resources/

# Backup files
*.bak
*.backup

# Temporary directories
cff_parser/

# Git worktrees
.worktrees/

# Crystal compiler cache
.crystal-cache/

# Local agent/tool settings
.claude/

# Markdown linter (rumdl) cache
/.rumdl_cache/

# Apple Double / Extended Attributes (macOS FAT32 artifacts)
._*
.DS_Store

# Fix scripts
fix_*.rb

# chiasmus analysis artifacts
/.chiasmus/

# chiasmus reconciliation bundle
/plans/generated/

# Inventory backups and classifier metadata (regenerated, not committed)
/plans/inventory/*.bak.tsv
/plans/inventory/*.metadata.json

# Local session notes
/session/
